{
  "name": "google-antigravity-acp",
  "version": "1.1.2",
  "description": "ACP adapter and native OpenClaw CLI backend for Google Antigravity",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "google-antigravity-acp": "dist/cli.js",
    "google-antigravity-cli": "dist/one-shot-cli.js"
  },
  "openclaw": {
    "extensions": [
      "./src/openclaw-plugin.ts"
    ],
    "runtimeExtensions": [
      "./dist/openclaw-plugin.js"
    ],
    "install": {
      "npmSpec": "google-antigravity-acp",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.3"
    },
    "compat": {
      "pluginApi": ">=2026.9.3",
      "minGatewayVersion": ">=2026.9.3"
    },
    "build": {
      "openclawVersion": "2026.9.3",
      "pluginSdkVersion": "2026.9.3"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true,
      "bundleRuntimeDependencies": false
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sibbl/google-antigravity-acp.git"
  },
  "bugs": {
    "url": "https://github.com/sibbl/google-antigravity-acp/issues"
  },
  "homepage": "https://github.com/sibbl/google-antigravity-acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "antigravity",
    "google",
    "gemini",
    "coding-agent",
    "acpx",
    "openclaw"
  ],
  "author": "Antigravity ACP Contributors",
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "openclaw": "2026.9.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  }
}
