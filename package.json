{
  "name": "google-antigravity-acp",
  "version": "1.0.1",
  "description": "Agent Client Protocol (ACP) server for Google Antigravity, compatible with acpx and other ACP clients",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "google-antigravity-acp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sibbl/google-antigravity-acp.git"
  },
  "bugs": {
    "url": "https://github.com/sibbl/google-antigravity-acp/issues"
  },
  "homepage": "https://github.com/sibbl/google-antigravity-acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "antigravity",
    "google",
    "gemini",
    "coding-agent",
    "acpx",
    "openclaw"
  ],
  "author": "Antigravity ACP Contributors",
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
